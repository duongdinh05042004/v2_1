# =============================================================================
# Google Sheets
# =============================================================================
# Chọn một trong hai: service_account | oauth2
GOOGLE_AUTH_MODE=service_account

# Service Account: đường dẫn tới file JSON (KHÔNG commit file này)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# OAuth 2.0 user authentication (dùng khi GOOGLE_AUTH_MODE=oauth2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_TOKEN_FILE=./credentials/google-oauth-token.json

# Spreadsheet
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_WORKSHEET_NAME=Leads

# =============================================================================
# Bitrix24
# =============================================================================
# Chọn một trong hai: webhook | oauth2
BITRIX_AUTH_MODE=webhook

# Incoming webhook, ví dụ: https://your-domain.bitrix24.com/rest/1/xxxxx/
BITRIX_WEBHOOK_URL=

# OAuth 2.0 (dùng khi BITRIX_AUTH_MODE=oauth2)
BITRIX_OAUTH_CLIENT_ID=
BITRIX_OAUTH_CLIENT_SECRET=
BITRIX_OAUTH_DOMAIN=your-domain.bitrix24.com
BITRIX_OAUTH_ACCESS_TOKEN=
BITRIX_OAUTH_REFRESH_TOKEN=
# Token được refresh tự động và ghi lại file này (không commit)
BITRIX_OAUTH_TOKEN_FILE=./credentials/bitrix-oauth-token.json

# =============================================================================
# Sync
# =============================================================================
# one_way: Sheets -> Bitrix | two_way: cả hai chiều
SYNC_DIRECTION=one_way

# Cron: mỗi 15 phút | 0 * * * * (mỗi giờ) | 0 8 * * * (hàng ngày 8h)
SYNC_CRON=*/15 * * * *

# last_write_wins | sheet_wins | bitrix_wins
CONFLICT_STRATEGY=last_write_wins

# Số record xử lý song song trong một batch Bitrix (tối đa 50)
BITRIX_BATCH_SIZE=50
# Nghỉ giữa các batch để tôn trọng rate limit Bitrix (~2 req/s)
BITRIX_BATCH_PAUSE_MS=400

# Retry
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=500

# Dry-run: chỉ log, không ghi Bitrix/Sheet
SYNC_DRY_RUN=false

# =============================================================================
# App / Admin
# =============================================================================
PORT=3000
NODE_ENV=development

# Token bảo vệ HTTP trigger & admin API (để trống = không bắt buộc ở local)
ADMIN_API_TOKEN=change-me-in-production

# Đường dẫn file mapping
MAPPING_FILE=./config/mapping.json

# Lưu trạng thái đồng bộ
SYNC_STATE_FILE=./data/sync-state.json
LOG_DIR=./logs
